{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BWM KUL City Walk Heritage Threads",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "title", "theme", "summary", "stops"],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "theme": {
        "type": "string",
        "minLength": 1
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "stops": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "required": ["siteId", "chapter", "visitMinutes", "walkMinutesFromPrevious"],
          "properties": {
            "siteId": {
              "type": "string",
              "minLength": 1
            },
            "chapter": {
              "type": "string",
              "minLength": 1
            },
            "visitMinutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "walkMinutesFromPrevious": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
